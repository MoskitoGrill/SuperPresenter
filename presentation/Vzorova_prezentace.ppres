{"format": "PresentationPresenter", "version": 2, "document": {"title": "PresentationPresenter — průvodce funkcemi", "sections": [{"title": "01 • Vítejte", "blocks": [{"runs": [{"text": "PresentationPresenter", "style": {"bold": true, "italic": false, "underline": false, "color": "#ffffff", "size": 52, "family": "Calibri"}, "id": "e2eceaef-604c-4d7e-adda-552399c9cc6e"}], "kind": "paragraph", "id": "af85334e-af2c-48c4-b936-6242fd0448ab"}, {"runs": [{"text": "Vzorová prezentace všech hlavních možností aplikace.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "d5970e38-3412-4607-bc59-b247a59e1deb"}], "kind": "paragraph", "id": "995107b3-6c19-4d2f-9e55-08fea2c7b3d6"}, {"runs": [{"text": "Sál 4:3 • stream 16:9 • kamera vpravo dole", "style": {"bold": false, "italic": false, "underline": false, "color": "#f4bf4f", "family": "Calibri"}, "id": "eef32bbd-2c85-4bdd-a624-7444006313b1"}], "kind": "paragraph", "id": "4afb90aa-44b1-4615-af3c-14f4420b7b76"}, {"runs": [{"text": "Barevné obdélníky zastupují obrázky. Doprovodný návod obsahuje další pokusy.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "0df04a86-a829-4f2c-aade-d2a81c498c8b"}], "kind": "paragraph", "id": "c11c6bde-7085-414e-8276-258b679333ef"}], "reference": "", "break_after": true, "origin": null, "id": "a17e7391-4ee6-4f64-9686-47c86d95e3ae", "break_before": false, "images": [], "stream_linked": true, "type": "text"}, {"title": "02 • Název, odkaz a odstavce", "blocks": [{"runs": [{"text": "Toto je první odstavec. Text můžete upravovat přímo v editoru.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "01ddb7f2-d13c-4394-a98a-ee5c7b9fd365"}], "kind": "paragraph", "id": "105230d2-6b09-4c93-8f19-31561042cdb3"}, {"runs": [{"text": "Druhý odstavec zůstává samostatný. Název úseku a odkaz jsou oddělená pole.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "afe87970-4c68-4010-8ad9-7e080562d2cf"}], "kind": "paragraph", "id": "df86f5ba-208d-4204-b0d5-d0c04f29a784"}], "reference": "Ukázka odkazu • Jan 3:16–18", "break_after": true, "origin": null, "id": "f6434559-6057-4a09-aa6e-ee6fea7b291c", "break_before": false, "images": [], "stream_linked": true, "type": "text"}, {"title": "03 • Formátování uvnitř textu", "blocks": [{"runs": [{"text": "Běžný text, ", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "b5d3932a-dcb9-47f2-879a-e06b7758b549"}, {"text": "tučný důraz", "style": {"bold": true, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "f355a75a-794c-4a0b-af44-44e64282ee40"}, {"text": ", kurzíva", "style": {"bold": false, "italic": true, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "3e8f2bbc-1cb3-4984-b6f9-e69e0f9236e4"}, {"text": " a podtržení.", "style": {"bold": false, "italic": false, "underline": true, "color": "#ffffff", "family": "Calibri"}, "id": "9b08e182-4eeb-4032-beba-d61d5baeae95"}], "kind": "paragraph", "id": "e6be79ac-9be3-4338-b7c4-72acbe9b5739"}, {"runs": [{"text": "Barevný text", "style": {"bold": false, "italic": false, "underline": false, "color": "#f4bf4f", "family": "Calibri"}, "id": "906f4de2-c7f1-473a-b9f6-b6a3009b53bc"}], "kind": "paragraph", "id": "b6e7a181-e604-4b09-8cf4-cd2e9cadec0e"}, {"runs": [{"text": "Menší písmo • 28", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "size": 28, "family": "Calibri"}, "id": "bd2121d2-16dd-4ce3-a4db-75005eeb2bb5"}], "kind": "paragraph", "id": "839a23bd-df02-4c52-af1c-0add640bbb1f"}, {"runs": [{"text": "Větší písmo • 48", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "size": 48, "family": "Calibri"}, "id": "8e967621-5484-4a9d-b23a-27bec57f312c"}], "kind": "paragraph", "id": "37d506ce-69b6-4489-b07c-98bcc09477de"}, {"runs": [{"text": "Jiný font: Georgia", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "size": 32, "family": "Georgia"}, "id": "d9fbb40c-6e4e-4f64-a608-441ff44b65ab"}], "kind": "paragraph", "id": "496c995c-f5ab-4359-93d4-4cca2868fb92"}], "reference": "", "break_after": true, "origin": null, "id": "5f23ecc9-57b0-4986-8189-ec0e37e2f036", "break_before": false, "images": [], "stream_linked": true, "type": "text"}, {"title": "04 • Odrážky a úrovně", "blocks": [{"runs": [{"text": "První hlavní bod", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "41489019-7402-4490-917f-275155b75cc5"}], "kind": "bullet", "id": "ac0f7bd3-33b2-4ca1-aefd-9e8c2129da45"}, {"runs": [{"text": "Podrobnost první úrovně", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "edb1d313-9fad-48b4-9ca9-380b34f8e0c7"}], "kind": "bullet", "id": "110aa82d-b0b9-4856-b0f4-b63bef3fe909", "level": 1}, {"runs": [{"text": "Ještě podrobnější bod", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "360b9f53-02c3-4051-a0b8-12862f7244aa"}], "kind": "bullet", "id": "9b5f0a5f-d2c4-4194-946a-c21be242aab2", "level": 2}, {"runs": [{"text": "Druhý hlavní bod", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "db20f5db-8519-493f-9203-d1d459de8098"}], "kind": "bullet", "id": "96b8a2f9-87f6-4e9d-a873-b16a8fb2464c"}, {"runs": [{"text": "Odstavec mimo seznam.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "089134c4-6626-410e-a808-d8a2fa8f30c6"}], "kind": "paragraph", "id": "c369347d-7600-45a3-bb92-b7bb5cc1491d"}], "reference": "", "break_after": true, "origin": null, "id": "3a41a0d0-6dad-42bb-985f-8aa159d61bdc", "break_before": false, "images": [], "stream_linked": true, "type": "text"}, {"title": "05 • Číslovaný seznam", "blocks": [{"runs": [{"text": "Připravte obsah.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "d206d6b3-e789-4737-bbb7-1116d7061416"}], "kind": "numbered", "id": "35bf3246-4839-4f2c-ba23-63d18fe23d3a"}, {"runs": [{"text": "Zkontrolujte oba náhledy.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "d3c6f07d-2a66-4eff-a062-9b333c3fa307"}], "kind": "numbered", "id": "66ca0a5c-5a47-4727-96ba-39133c549bc0"}, {"runs": [{"text": "Podrobnost kroku", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "c75446d6-c5aa-4273-9f03-236a5f3acf18"}], "kind": "numbered", "id": "8ade3be7-4e4d-4285-930c-9b3f84b2e81c", "level": 1}, {"runs": [{"text": "Potvrďte změny do projekce.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "08fabf07-435e-41cf-b6e5-64081132e280"}], "kind": "numbered", "id": "adc1dd39-bd3b-42ec-8c60-a64b8603fb98"}], "reference": "", "break_after": true, "origin": null, "id": "a0ee50b5-dced-4458-b82b-e22ca3260046", "break_before": false, "images": [], "stream_linked": true, "type": "text"}, {"title": "06 • Automatické dělení dlouhého textu", "blocks": [{"runs": [{"text": "Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. ", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "4a4a5d64-5762-45fc-86a7-6a6513143c18"}], "kind": "paragraph", "id": "aba15e90-203f-4ba8-9984-1e56dfbba93c"}, {"runs": [{"text": "Druhý odstavec příběhu. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. ", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "8635fe9e-3f9a-4543-85e4-ee8c639efe5c"}], "kind": "paragraph", "id": "6c71e1f2-a753-42d6-858f-d8d1b6967c41"}], "reference": "Společný obsah • různé zalomení sálu a streamu", "break_after": true, "origin": null, "id": "09b735df-8827-4651-9b25-36b792322051", "break_before": false, "images": [], "stream_linked": true, "type": "text"}, {"title": "07 • Dlouhá odrážka a pokračování", "blocks": [{"runs": [{"text": "Tato odrážka pokračuje přes více snímků. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. ", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "495a9983-72ea-46a3-82e4-c81c9426d327"}], "kind": "bullet", "id": "84c40446-8af0-475b-9a4d-c421c9dcb88a"}, {"runs": [{"text": "Další bod začíná až po dokončení předchozího.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "474c9f84-0e18-4755-8613-58349627e89a"}], "kind": "bullet", "id": "41c4b431-07ce-4122-85b5-9fca117ba959"}], "reference": "", "break_after": true, "origin": null, "id": "0ea3d251-5096-4f65-bf03-41556105339c", "break_before": false, "images": [], "stream_linked": true, "type": "text"}, {"title": "08 • Bible souvisle bez čísel", "blocks": [{"runs": [{"text": "„Neboť tak Bůh miluje svět, že dal svého jediného Syna, aby žádný, kdo v něho věří, nezahynul, ale měl život věčný. Vždyť Bůh neposlal svého Syna na svět, aby svět odsoudil, ale aby byl svět skrze něj zachráněn. Kdo v něho věří, není souzen, kdo však nevěří, již je odsouzen, protože neuvěřil ve jméno jediného Syna Božího.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "dafc441b-de6b-410f-8840-c2cbf75c8ae3"}], "kind": "paragraph", "id": "84130622-84c3-4d9d-85c3-21a31beca465"}], "reference": "Jan 3:16–18 (CSP)", "break_after": true, "origin": null, "id": "4f68113b-6124-4deb-8bbc-e0c1a5a5eca6", "break_before": true, "images": [], "stream_linked": true, "type": "text"}, {"title": "09 • Bible souvisle s čísly", "blocks": [{"runs": [{"text": "16 „Neboť tak Bůh miluje svět, že dal svého jediného Syna, aby žádný, kdo v něho věří, nezahynul, ale měl život věčný. 17 Vždyť Bůh neposlal svého Syna na svět, aby svět odsoudil, ale aby byl svět skrze něj zachráněn. 18 Kdo v něho věří, není souzen, kdo však nevěří, již je odsouzen, protože neuvěřil ve jméno jediného Syna Božího.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "93af4ac5-6ecb-4e08-9017-027698849042"}], "kind": "paragraph", "id": "bc49c004-1ce9-4e91-9fc1-ea21fb150899"}], "reference": "Jan 3:16–18 (CSP)", "break_after": true, "origin": null, "id": "b1eb87dd-36b2-4638-97dd-8c182818797f", "break_before": true, "images": [], "stream_linked": true, "type": "text"}, {"title": "10 • Bible po verších s čísly", "blocks": [{"runs": [{"text": "16 „Neboť tak Bůh miluje svět, že dal svého jediného Syna, aby žádný, kdo v něho věří, nezahynul, ale měl život věčný.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "d7c81804-753b-4904-927b-22fee54b7fd8"}], "kind": "paragraph", "id": "e308dba6-3a63-49a4-aa51-22c5a81a9001"}, {"runs": [{"text": "17 Vždyť Bůh neposlal svého Syna na svět, aby svět odsoudil, ale aby byl svět skrze něj zachráněn.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "b38b6f23-b4e6-446b-9c8a-ac10538fa588"}], "kind": "paragraph", "id": "48e8156a-ed3c-4ea7-a106-e932c1950b5c"}, {"runs": [{"text": "18 Kdo v něho věří, není souzen, kdo však nevěří, již je odsouzen, protože neuvěřil ve jméno jediného Syna Božího.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "77150be5-083a-406b-b16c-6194a6d02df2"}], "kind": "paragraph", "id": "609b06d7-5e05-4d86-be5b-87a7a7c42c96"}], "reference": "Jan 3:16–18 (CSP)", "break_after": true, "origin": null, "id": "eb82d446-8b9b-4856-bd5a-8c3f23625064", "break_before": true, "images": [], "stream_linked": true, "type": "text"}, {"title": "11 • Čtení bez černého předělu A", "blocks": [{"runs": [{"text": "Tato pasáž přejde rovnou na další úsek.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "1c7cc3dc-4b16-4fb4-9778-0c03be9096d6"}], "kind": "paragraph", "id": "ad639518-0c87-4759-9acb-c051d9d05296"}], "reference": "Ukázková pasáž A", "break_after": false, "origin": null, "id": "1b070886-4903-4537-864a-85e3623ce137", "break_before": false, "images": [], "stream_linked": true, "type": "text"}, {"title": "12 • Čtení bez černého předělu B", "blocks": [{"runs": [{"text": "Mezi těmito dvěma úseky není černý snímek.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "4e5f62cf-4dc8-46a2-9ceb-3eadb84e89a0"}], "kind": "paragraph", "id": "21be4a5f-4596-41ca-a58d-d5583f50739e"}], "reference": "Ukázková pasáž B", "break_after": true, "origin": null, "id": "36dfa556-724c-4eac-8edb-52fd1b868580", "break_before": false, "images": [], "stream_linked": true, "type": "text"}, {"title": "13 • Sloučení — první část", "blocks": [{"runs": [{"text": "První část byla původně na jednom snímku.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "1c657351-af95-4d82-9324-a0c742ea7ff0"}], "kind": "paragraph", "id": "a4e8222b-96c8-4c7f-9543-38f6361f7e12"}], "reference": "Přísloví 2:16 • ukázka sloučení", "break_after": false, "origin": null, "id": "7a971b1b-1ccd-48c8-97ed-bd1ddfe47272", "break_before": false, "images": [], "stream_linked": true, "type": "text"}, {"title": "14 • Sloučení — druhá část", "blocks": [{"runs": [{"text": "Druhá část byla na dalším. Zkuste oba úseky sloučit a nechat text znovu rozdělit aplikací.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "a0da8975-075d-4bea-9b6d-27db7482ae48"}], "kind": "paragraph", "id": "fca05334-91d5-4902-9ae0-fb9f53fd3e84"}], "reference": "Přísloví 2:16 • ukázka sloučení", "break_after": true, "origin": null, "id": "a493ba87-326d-4331-9b9d-1c8db7f0c5c0", "break_before": false, "images": [], "stream_linked": true, "type": "text"}, {"title": "15 • Samostatný obrázek", "media_id": "79f7a9a2-677c-4043-b177-985ed6079594", "alt_text": "Korálový obdélník na šířku", "reference": "", "break_after": true, "origin": null, "id": "f062580e-4d49-4968-b1c8-80b4f79bb38f", "break_before": false, "type": "image"}, {"title": "16 • Automatická mřížka obrázků", "blocks": [], "reference": "", "break_after": true, "origin": null, "id": "37f87e92-b6ff-4612-a96a-acd2ad428797", "break_before": false, "images": [{"media_id": "79f7a9a2-677c-4043-b177-985ed6079594", "hall": null, "stream": null, "repeat": true, "id": "3566e264-a6f4-4ec6-b152-bca348b8f89d", "alt_text": "Barevný obdélník 1"}, {"media_id": "b3502207-954b-4726-a87c-c58ddb945170", "hall": null, "stream": null, "repeat": true, "id": "dfd0eb37-cb4b-4b40-ad68-0ee73bfd36db", "alt_text": "Barevný obdélník 2"}, {"media_id": "96128a75-a105-4339-8d8f-0b6db89a745d", "hall": null, "stream": null, "repeat": true, "id": "b9fe00a9-e892-4899-83e1-2028109e0876", "alt_text": "Barevný obdélník 3"}, {"media_id": "1ee9795f-1dd7-4fe0-a90d-f8a22fda79ae", "hall": null, "stream": null, "repeat": true, "id": "844ea686-1884-4127-8c58-55485eff1357", "alt_text": "Barevný obdélník 4"}], "stream_linked": true, "type": "text"}, {"title": "17 • Text a obrázek společně", "blocks": [{"runs": [{"text": "Text obtéká barevný obdélník. Ve streamu navíc respektuje prostor kamery.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "2296a9c9-a0dc-4915-bea7-d316dd958d30"}], "kind": "paragraph", "id": "25f06240-ae09-4c34-801a-8e74ea1d0a47"}, {"runs": [{"text": "Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. ", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "26e648ac-a085-4746-b5c3-d079166f14e5"}], "kind": "paragraph", "id": "ff097609-3fee-4da7-907e-efaa82519bb5"}], "reference": "", "break_after": true, "origin": null, "id": "a92fe06f-bb56-4f60-8b31-15b36afab62e", "break_before": false, "images": [{"media_id": "b3502207-954b-4726-a87c-c58ddb945170", "hall": null, "stream": null, "repeat": true, "id": "05d094ef-1046-4e1e-a6b6-10e7f8ad1ca1", "alt_text": "Tyrkysový svislý obdélník"}], "stream_linked": true, "type": "text"}, {"title": "18 • Ruční umístění pro každý výstup", "blocks": [{"runs": [{"text": "Obdélníky mají v sále jiné pozice než ve streamu. Výstupy jsou pro tento úsek odpojené.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "d7a847a2-ab77-4c8a-aba5-6de6b0dbface"}], "kind": "paragraph", "id": "1a237351-a941-420c-a64a-a615994f67cf"}], "reference": "", "break_after": true, "origin": null, "id": "191ae7ef-3f75-484a-9811-f70c98d52bba", "break_before": false, "images": [{"media_id": "79f7a9a2-677c-4043-b177-985ed6079594", "hall": {"x": 0.06, "y": 0.45, "width": 0.34}, "stream": {"x": 0.04, "y": 0.38, "width": 0.26}, "repeat": true, "id": "48e4bd21-fb91-446c-b789-15dbbbb8b9b8", "alt_text": ""}, {"media_id": "96128a75-a105-4339-8d8f-0b6db89a745d", "hall": {"x": 0.61, "y": 0.48, "width": 0.23}, "stream": {"x": 0.34, "y": 0.43, "width": 0.18}, "repeat": true, "id": "d209a8ba-a65f-4510-8027-a13475062725", "alt_text": ""}], "stream_linked": false, "type": "text"}, {"title": "19 • Obrázek jen na prvním pokračování", "blocks": [{"runs": [{"text": "Žlutý obdélník se objeví pouze na prvním pokračování tohoto úseku. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. ", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "42590917-30f3-4382-a197-58f96a935013"}], "kind": "paragraph", "id": "7cab1e53-4ecf-4b53-9dee-6e36e33969c8"}], "reference": "", "break_after": true, "origin": null, "id": "180d0c6b-ad7f-46bf-a396-f3508aa33986", "break_before": false, "images": [{"media_id": "96128a75-a105-4339-8d8f-0b6db89a745d", "hall": null, "stream": null, "repeat": false, "id": "64c20676-043f-43d4-8a9e-6e4d23bb309d", "alt_text": "Žlutý čtverec pouze na začátku"}], "stream_linked": true, "type": "text"}, {"title": "20 • Obrázek na všech pokračováních", "blocks": [{"runs": [{"text": "Fialový obdélník se opakuje na všech pokračováních. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. Na cestu jsme vyrazili brzy ráno. Za vesnicí se otevřel výhled do údolí. Zastavili jsme se, abychom si společně přečetli další část příběhu. Každý mohl přidat otázku a pak jsme pokračovali dál. ", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "6df1c98b-0373-47f9-b711-c327d2e1e094"}], "kind": "paragraph", "id": "d10892f7-6d89-417d-bd66-fce2a3c4d5f5"}], "reference": "", "break_after": true, "origin": null, "id": "5f27401e-930c-4dc1-bff5-b2ea993de915", "break_before": false, "images": [{"media_id": "1ee9795f-1dd7-4fe0-a90d-f8a22fda79ae", "hall": null, "stream": null, "repeat": true, "id": "64dce87c-ef8d-460b-bf2b-a585bf9b1029", "alt_text": "Fialový obdélník opakovaně"}], "stream_linked": true, "type": "text"}, {"title": "21 • Zkouška živé projekce", "blocks": [{"runs": [{"text": "Spusťte projekci. Potom v editoru změňte tuto větu.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "97939f9c-e001-4b89-9d93-86eafc21866a"}], "kind": "paragraph", "id": "7b1b1d14-2919-4117-a764-c57f9cdff820"}, {"runs": [{"text": "Živý výstup se změní až po potvrzení do projekce.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "e2b57e4b-4796-4b79-982c-3de0d420a58c"}], "kind": "paragraph", "id": "d4d44f14-9336-47dc-8f2e-42901b7200fb"}, {"runs": [{"text": "Vyzkoušejte šipky, černou obrazovku, návrat a ukončení podle ovládání aplikace.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "3100e7c4-db98-4cca-ae76-b656b4cdd307"}], "kind": "paragraph", "id": "26debe59-6b13-4e57-bba0-d815e1d3a35d"}], "reference": "", "break_after": true, "origin": null, "id": "54c88651-3681-4048-b3c4-81d18964b45e", "break_before": false, "images": [], "stream_linked": true, "type": "text"}, {"title": "22 • Konec ukázky", "blocks": [{"runs": [{"text": "Další možnosti vyzkoušíte podle přiloženého návodu.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "2bf2d487-adc0-4e88-82af-3216c2199f0c"}], "kind": "paragraph", "id": "5322ab53-aa76-481a-bc7d-1b1388f0f0b4"}, {"runs": [{"text": "Prezentaci si uložte pod vlastním názvem a upravujte její kopii.", "style": {"bold": false, "italic": false, "underline": false, "color": "#ffffff", "family": "Calibri"}, "id": "576279a1-be88-48f3-8461-353fbcc88896"}], "kind": "paragraph", "id": "3f12d595-2ded-4012-8f98-b4c4b8444f07"}], "reference": "", "break_after": false, "origin": null, "id": "5f71edf9-ac7d-46e2-8b71-fa6ebf528556", "break_before": false, "images": [], "stream_linked": true, "type": "text"}], "media": [{"locator": "data:image/png;base64,", "mime_type": "image/png", "id": "79f7a9a2-677c-4043-b177-985ed6079594"}, {"locator": "data:image/png;base64,", "mime_type": "image/png", "id": "b3502207-954b-4726-a87c-c58ddb945170"}, {"locator": "data:image/png;base64,", "mime_type": "image/png", "id": "96128a75-a105-4339-8d8f-0b6db89a745d"}, {"locator": "data:image/png;base64,", "mime_type": "image/png", "id": "1ee9795f-1dd7-4fe0-a90d-f8a22fda79ae"}], "hall": {"aspect": "4:3", "camera": null}, "stream": {"aspect": "16:9", "camera": {"x": 0.64, "y": 0.62, "width": 0.36, "height": 0.38, "gap": 0.02}}, "black_start": true, "id": "c99ffe61-1c55-48aa-90cc-151860033180", "schema_version": 2, "black_end": true}}